@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="text-center mt-5">
            <i class="bi bi-shield-x" style="font-size: 5rem; color: #dc3545;"></i>
            <h1 class="display-4 mt-3">Access Denied</h1>
            <p class="lead">You do not have permission to access this resource.</p>
            <p class="text-muted">Please contact your administrator if you believe this is an error.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Go to Home</a>
        </div>
    </div>
</div>
