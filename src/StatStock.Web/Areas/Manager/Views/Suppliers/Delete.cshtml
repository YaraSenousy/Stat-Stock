@model Supplier
@{
    ViewData["Title"] = "Delete Supplier";
}

<!-- Back Button -->
<div class="mb-6">
    <a href="/Manager/Suppliers" class="inline-flex items-center px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-800 bg-white rounded-xl border border-slate-200 hover:border-slate-300 shadow-sm transition-all">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Suppliers
    </a>
</div>

<!-- Confirmation Card -->
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <!-- Header -->
    <div class="p-8 border-b border-slate-100 bg-gradient-to-r from-red-50 to-white">
        <div class="flex items-center space-x-4">
            <div class="w-16 h-16 bg-gradient-to-br from-red-500 to-red-600 rounded-2xl flex items-center justify-center shadow-lg shadow-red-500/30">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Delete Supplier</h1>
                <p class="text-red-600 text-sm mt-1">This action cannot be undone</p>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="p-8">
        <!-- Warning Message -->
        <div class="bg-red-50 border-l-4 border-red-500 p-6 mb-8 rounded-lg">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-6 w-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-bold text-red-800">
                        Are you sure you want to delete this supplier?
                    </h3>
                    <div class="mt-2 text-sm text-red-700">
                        <p>This will permanently delete the supplier from your system. If this supplier is referenced in existing orders, the deletion may fail.</p>
                        @if (Model.Orders.Any())
                        {
                            <p class="mt-2 font-semibold">⚠️ This supplier has @Model.Orders.Count active order(s).</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl mb-6">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- Supplier Details -->
        <div class="bg-slate-50 rounded-2xl p-6 mb-8">
            <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Supplier Information
            </h3>
            
            <dl class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <dt class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Company Name</dt>
                    <dd class="mt-2 text-slate-900 font-semibold">@Model.Name</dd>
                </div>
                
                <div>
                    <dt class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Contact Person</dt>
                    <dd class="mt-2 text-slate-900 font-semibold">@Model.Contact</dd>
                </div>
                
                <div>
                    <dt class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Email</dt>
                    <dd class="mt-2 text-slate-900">@Model.Email</dd>
                </div>
                
                <div>
                    <dt class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Phone</dt>
                    <dd class="mt-2 text-slate-900">@Model.Phone</dd>
                </div>
                
                <div class="md:col-span-2">
                    <dt class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Address</dt>
                    <dd class="mt-2 text-slate-900">@Model.Address</dd>
                </div>
            </dl>
        </div>

        <!-- Action Buttons -->
        <form asp-action="Delete" method="post" class="flex items-center justify-end space-x-4 pt-6 border-t border-slate-200">
            <input type="hidden" asp-for="Id" />
            
            <a href="/Manager/Suppliers" class="px-6 py-2.5 border border-slate-300 text-slate-700 font-medium rounded-xl hover:bg-slate-50 transition-all">
                Cancel
            </a>
            
            <button type="submit" class="px-6 py-2.5 bg-gradient-to-r from-red-600 to-red-700 text-white font-semibold rounded-xl hover:from-red-700 hover:to-red-800 transition-all shadow-lg shadow-red-500/30">
                Delete Supplier
            </button>
        </form>
    </div>
</div>
