@using StatStock.Domain.Enums
@model Supplier
@{
    ViewData["Title"] = "Supplier Details";
}

<!-- Back Button -->
<div class="mb-6">
    <a href="/Manager/Suppliers" class="inline-flex items-center px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-800 bg-white rounded-xl border border-slate-200 hover:border-slate-300 shadow-sm transition-all">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Suppliers
    </a>
</div>

<!-- Main Card -->
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <!-- Header -->
    <div class="p-8 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white">
        <div class="flex items-start justify-between">
            <div class="flex items-center space-x-4">
                <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center shadow-lg shadow-primary-500/30">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">@Model.Name</h1>
                    <p class="text-slate-500 text-sm mt-1">Contact: @Model.Contact</p>
                </div>
            </div>
            <div>
                <a href="/Manager/Suppliers/Edit/@Model.Id" class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-gradient-to-r from-primary-600 to-primary-700 rounded-xl hover:from-primary-700 hover:to-primary-800 transition-all shadow-lg shadow-primary-500/30">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                    Edit Supplier
                </a>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="p-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Contact Information -->
            <div class="bg-slate-50 rounded-2xl p-6">
                <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    Contact Information
                </h3>
                <dl class="space-y-5">
                    <div>
                        <dt class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Email</dt>
                        <dd class="mt-2">
                            <a href="mailto:@Model.Email" class="text-primary-600 hover:text-primary-700">@Model.Email</a>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Phone</dt>
                        <dd class="mt-2 text-slate-800">@Model.Phone</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Address</dt>
                        <dd class="mt-2 text-slate-800 whitespace-pre-line">@Model.Address</dd>
                    </div>
                </dl>
            </div>

            <!-- Statistics -->
            <div class="bg-slate-50 rounded-2xl p-6">
                <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                    Order Statistics
                </h3>
                <dl class="space-y-5">
                    <div>
                        <dt class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Total Orders</dt>
                        <dd class="mt-2">
                            <span class="text-4xl font-bold text-slate-900">@Model.Orders.Count</span>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Member Since</dt>
                        <dd class="mt-2 text-slate-800">@Model.CreatedAt.ToString("MMMM dd, yyyy")</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Last Updated</dt>
                        <dd class="mt-2 text-slate-800">@Model.UpdatedAt.ToString("MMMM dd, yyyy")</dd>
                    </div>
                </dl>
            </div>
        </div>

        <!-- Recent Orders -->
        @if (Model.Orders.Any())
        {
            <div class="mt-8 bg-slate-50 rounded-2xl p-6">
                <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                    </svg>
                    Recent Orders
                </h3>
                
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-white border-b border-slate-200">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-bold text-slate-600 uppercase tracking-wider">Order #</th>
                                <th class="px-4 py-3 text-left text-xs font-bold text-slate-600 uppercase tracking-wider">Type</th>
                                <th class="px-4 py-3 text-left text-xs font-bold text-slate-600 uppercase tracking-wider">Status</th>
                                <th class="px-4 py-3 text-left text-xs font-bold text-slate-600 uppercase tracking-wider">Date</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var order in Model.Orders.OrderByDescending(o => o.CreatedAt).Take(10))
                            {
                                <tr class="hover:bg-white transition-colors">
                                    <td class="px-4 py-3">
                                        <a href="/Manager/Orders/Details/@order.Id" class="text-primary-600 hover:text-primary-700 font-mono text-sm">@order.OrderNumber</a>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-100 text-slate-700">
                                            @order.Type.ToString()
                                        </span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium 
                                            @(order.Status == OrderStatus.Approved ? "bg-emerald-100 text-emerald-800" : 
                                              order.Status == OrderStatus.Pending ? "bg-amber-100 text-amber-800" : 
                                              order.Status == OrderStatus.Cancelled ? "bg-red-100 text-red-800" : 
                                              "bg-slate-100 text-slate-700")">
                                            @order.Status.ToString()
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-slate-700">
                                        @order.CreatedAt.ToString("MMM dd, yyyy")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="mt-8 text-center py-12 bg-slate-50 rounded-2xl">
                <svg class="w-12 h-12 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
                <p class="text-slate-500 font-medium">No orders yet</p>
                <p class="text-slate-400 text-sm mt-1">Orders from this supplier will appear here</p>
            </div>
        }
    </div>
</div>
