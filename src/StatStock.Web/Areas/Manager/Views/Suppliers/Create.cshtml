@model Supplier
@{
    ViewData["Title"] = "Create Supplier";
}

<!-- Back Button -->
<div class="mb-6">
    <a href="/Manager/Suppliers" class="inline-flex items-center px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-800 bg-white rounded-xl border border-slate-200 hover:border-slate-300 shadow-sm transition-all">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Suppliers
    </a>
</div>

<!-- Form Card -->
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <!-- Header -->
    <div class="p-8 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white">
        <div class="flex items-center space-x-4">
            <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center shadow-lg shadow-primary-500/30">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Create New Supplier</h1>
                <p class="text-slate-500 text-sm mt-1">Add a new supplier to your network</p>
            </div>
        </div>
    </div>

    <!-- Form Content -->
    <div class="p-8">
        <form asp-action="Create" method="post" class="space-y-8">
            <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl mb-6"></div>

            <!-- Basic Information Section -->
            <div class="bg-slate-50 rounded-2xl p-6">
                <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Supplier Information
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Name -->
                    <div>
                        <label asp-for="Name" class="block text-sm font-semibold text-slate-700 mb-2">Company Name *</label>
                        <input asp-for="Name" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition" placeholder="e.g., ABC Supply Co." />
                        <span asp-validation-for="Name" class="text-red-600 text-sm mt-1 block"></span>
                    </div>

                    <!-- Contact Person -->
                    <div>
                        <label asp-for="Contact" class="block text-sm font-semibold text-slate-700 mb-2">Contact Person *</label>
                        <input asp-for="Contact" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition" placeholder="e.g., John Smith" />
                        <span asp-validation-for="Contact" class="text-red-600 text-sm mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Contact Information Section -->
            <div class="bg-slate-50 rounded-2xl p-6">
                <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    Contact Details
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Email -->
                    <div>
                        <label asp-for="Email" class="block text-sm font-semibold text-slate-700 mb-2">Email *</label>
                        <input asp-for="Email" type="email" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition" placeholder="supplier@example.com" />
                        <span asp-validation-for="Email" class="text-red-600 text-sm mt-1 block"></span>
                    </div>

                    <!-- Phone -->
                    <div>
                        <label asp-for="Phone" class="block text-sm font-semibold text-slate-700 mb-2">Phone *</label>
                        <input asp-for="Phone" type="tel" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition" placeholder="+1 (555) 123-4567" />
                        <span asp-validation-for="Phone" class="text-red-600 text-sm mt-1 block"></span>
                    </div>

                    <!-- Address -->
                    <div class="md:col-span-2">
                        <label asp-for="Address" class="block text-sm font-semibold text-slate-700 mb-2">Address</label>
                        <textarea asp-for="Address" rows="3" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition" placeholder="Enter full address..."></textarea>
                        <span asp-validation-for="Address" class="text-red-600 text-sm mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end space-x-4 pt-6 border-t border-slate-200">
                <a href="/Manager/Suppliers" class="px-6 py-2.5 border border-slate-300 text-slate-700 font-medium rounded-xl hover:bg-slate-50 transition-all">
                    Cancel
                </a>
                <button type="submit" class="px-6 py-2.5 bg-gradient-to-r from-primary-600 to-primary-700 text-white font-semibold rounded-xl hover:from-primary-700 hover:to-primary-800 transition-all shadow-lg shadow-primary-500/30">
                    Create Supplier
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
