@model IEnumerable<Product>
@{
    ViewData["Title"] = "Products";
}

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded-xl mb-6">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl mb-6">
        @TempData["ErrorMessage"]
    </div>
}

<!-- Header with Action Buttons -->
<div class="flex flex-col mb-6 gap-3">
    <div>
        <h1 class="text-2xl lg:text-3xl font-bold text-slate-900">Products</h1>
        <p class="text-slate-500 mt-1 text-sm">Manage your product inventory</p>
    </div>
    <div class="flex items-center gap-1.5 flex-wrap">
        <a href="/Manager/Products/Import" 
           class="inline-flex items-center justify-center p-2 lg:px-3 lg:py-2 text-xs lg:text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
           title="Import products">
            <svg class="w-4 h-4 flex-shrink-0 lg:mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
            </svg>
            <span class="hidden md:inline">Import</span>
        </a>
        <a href="/Manager/Products/Export" 
           class="inline-flex items-center justify-center p-2 lg:px-3 lg:py-2 text-xs lg:text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
           title="Export products">
            <svg class="w-4 h-4 flex-shrink-0 lg:mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span class="hidden md:inline">Export</span>
        </a>
        <a href="/Manager/Products/Create" 
           class="inline-flex items-center justify-center px-2 lg:px-3 py-2 bg-gradient-to-r from-primary-600 to-primary-700 text-white text-xs lg:text-sm font-semibold rounded-lg hover:from-primary-700 hover:to-primary-800 transition-all shadow-lg shadow-primary-500/30 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2"
           title="Create new product">
            <svg class="w-4 h-4 flex-shrink-0 lg:mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
            </svg>
            <span class="hidden md:inline">Create</span>
        </a>
    </div>
</div>

<!-- Filter Section -->
<div class="mb-6">
    <div class="bg-white rounded-xl lg:rounded-2xl shadow-sm border border-slate-200 p-3 lg:p-6">
        <form method="get" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2 lg:gap-4 items-end">
            <div>
                <label class="block text-xs lg:text-sm font-semibold text-slate-700 mb-1 lg:mb-2">Search</label>
                <div class="relative">
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 lg:w-5 lg:h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    <input type="text" name="search" value="@ViewBag.CurrentSearch" 
                           placeholder="Search..." 
                           class="w-full pl-9 pr-3 py-2 lg:py-2.5 text-xs lg:text-sm border border-slate-300 rounded-lg lg:rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition" />
                </div>
            </div>
            
            <div>
                <label class="block text-xs lg:text-sm font-semibold text-slate-700 mb-1 lg:mb-2">Category</label>
                <select name="category" 
                        class="w-full px-3 py-2 lg:py-2.5 text-xs lg:text-sm border border-slate-300 rounded-lg lg:rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition bg-white">
                    <option value="">All</option>
                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category" selected="@(category == ViewBag.CurrentCategory)">@category</option>
                    }
                </select>
            </div>
            
            <div>
                <label class="block text-xs lg:text-sm font-semibold text-slate-700 mb-1 lg:mb-2">Sort By</label>
                <select name="sortBy" 
                        class="w-full px-3 py-2 lg:py-2.5 text-xs lg:text-sm border border-slate-300 rounded-lg lg:rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition bg-white">
                    <option value="name" selected="@(ViewBag.CurrentSort == "name")">Name</option>
                    <option value="price" selected="@(ViewBag.CurrentSort == "price")">Price</option>
                    <option value="stock" selected="@(ViewBag.CurrentSort == "stock")">Stock</option>
                    <option value="category" selected="@(ViewBag.CurrentSort == "category")">Category</option>
                </select>
            </div>
            
            <div>
                <button type="submit" 
                        class="w-full bg-gradient-to-r from-primary-600 to-primary-700 text-white px-3 lg:px-6 py-2 lg:py-2.5 text-xs lg:text-sm rounded-lg lg:rounded-xl hover:from-primary-700 hover:to-primary-800 transition-all shadow-lg shadow-primary-500/30 font-semibold">
                    Apply
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Products Table -->
<div class="bg-white rounded-xl lg:rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-xs lg:text-sm">
            <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                    <th class="px-2 lg:px-4 py-2 lg:py-4 text-left font-bold text-slate-600 uppercase tracking-wider">SKU</th>
                    <th class="px-2 lg:px-4 py-2 lg:py-4 text-left font-bold text-slate-600 uppercase tracking-wider">Product</th>
                    <th class="px-2 lg:px-4 py-2 lg:py-4 text-left font-bold text-slate-600 uppercase tracking-wider">Category</th>
                    <th class="px-2 lg:px-4 py-2 lg:py-4 text-left font-bold text-slate-600 uppercase tracking-wider">Price</th>
                    <th class="px-2 lg:px-4 py-2 lg:py-4 text-left font-bold text-slate-600 uppercase tracking-wider">Stock</th>
                    <th class="px-2 lg:px-4 py-2 lg:py-4 text-left font-bold text-slate-600 uppercase tracking-wider">Status</th>
                    <th class="px-2 lg:px-4 py-2 lg:py-4 text-left font-bold text-slate-600 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var product in Model)
                {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-2 lg:px-4 py-2 lg:py-4">
                            <span class="font-mono font-semibold text-slate-900 line-clamp-1">@product.SKU</span>
                        </td>
                        <td class="px-2 lg:px-4 py-2 lg:py-4">
                            <div class="flex items-center space-x-2">
                                <div class="w-8 h-8 lg:w-10 lg:h-10 bg-gradient-to-br from-slate-100 to-slate-200 rounded-lg flex-shrink-0 flex items-center justify-center">
                                    <svg class="w-4 h-4 lg:w-5 lg:h-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                    </svg>
                                </div>
                                <div class="min-w-0">
                                    <p class="font-semibold text-slate-900 truncate">@product.Name</p>
                                    <p class="text-xs text-slate-500 truncate">@product.Description</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-2 lg:px-4 py-2 lg:py-4">
                            <span class="inline-flex items-center px-1.5 lg:px-2.5 py-0.5 lg:py-1 rounded-lg text-xs font-medium bg-slate-100 text-slate-700">
                                @product.Category
                            </span>
                        </td>
                        <td class="px-2 lg:px-4 py-2 lg:py-4 whitespace-nowrap">
                            <span class="font-bold text-slate-900">$@product.Price.ToString("N2")</span>
                        </td>
                        <td class="px-2 lg:px-4 py-2 lg:py-4 whitespace-nowrap">
                            <div class="flex items-center space-x-1">
                                <span class="font-bold @(product.StockQuantity <= product.ReorderLevel ? "text-red-600" : "text-slate-900")">
                                    @product.StockQuantity
                                </span>
                                @if (product.StockQuantity <= product.ReorderLevel)
                                {
                                    <span class="text-xs text-red-500 hidden lg:inline">(min: @product.ReorderLevel)</span>
                                }
                            </div>
                        </td>
                        <td class="px-2 lg:px-4 py-2 lg:py-4">
                            @if (product.StockQuantity <= product.ReorderLevel)
                            {
                                <span class="inline-flex items-center px-1.5 lg:px-2.5 py-0.5 lg:py-1 rounded-full text-xs font-medium bg-red-100 text-red-800 whitespace-nowrap">
                                    ⚠️ Low
                                </span>
                            }
                            else if (product.StockQuantity <= product.ReorderLevel * 2)
                            {
                                <span class="inline-flex items-center px-1.5 lg:px-2.5 py-0.5 lg:py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-800 whitespace-nowrap">
                                    ⚡ Warn
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-1.5 lg:px-2.5 py-0.5 lg:py-1 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800 whitespace-nowrap">
                                    ✓ OK
                                </span>
                            }
                        </td>
                        <td class="px-2 lg:px-4 py-2 lg:py-4">
                            <div class="flex items-center space-x-1">
                                <a href="/Manager/Products/Details/@product.Id" 
                                   class="inline-flex items-center p-1.5 lg:px-2 lg:py-1.5 text-primary-600 hover:text-primary-700 hover:bg-primary-50 rounded-lg transition"
                                   title="View Details">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    </svg>
                                </a>
                                <a href="/Manager/Products/Edit/@product.Id" 
                                   class="inline-flex items-center p-1.5 lg:px-2 lg:py-1.5 text-blue-600 hover:text-blue-700 hover:bg-blue-50 rounded-lg transition"
                                   title="Edit">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                    </svg>
                                </a>
                                <a href="/Manager/Products/Delete/@product.Id" 
                                   class="inline-flex items-center p-1.5 lg:px-2 lg:py-1.5 text-red-600 hover:text-red-700 hover:bg-red-50 rounded-lg transition"
                                   title="Delete">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                    </svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    @if (!Model.Any())
    {
        <div class="text-center py-8 lg:py-16">
            <div class="w-12 h-12 lg:w-16 lg:h-16 bg-slate-100 rounded-xl lg:rounded-2xl flex items-center justify-center mx-auto mb-3 lg:mb-4">
                <svg class="w-6 h-6 lg:w-8 lg:h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
            </div>
            <h3 class="text-base lg:text-lg font-semibold text-slate-900 mb-1">No products found</h3>
            <p class="text-xs lg:text-sm text-slate-500">Try adjusting your search or filter to find what you're looking for.</p>
        </div>
    }
</div>

<!-- Summary Stats -->
@if (Model.Any())
{
    <div class="mt-4 lg:mt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs lg:text-sm text-slate-500">
        <p>Showing <span class="font-semibold text-slate-700">@Model.Count()</span> products</p>
        <p>Total value: <span class="font-semibold text-slate-700">$@Model.Sum(p => p.Price * p.StockQuantity).ToString("N0")</span></p>
    </div>
}
