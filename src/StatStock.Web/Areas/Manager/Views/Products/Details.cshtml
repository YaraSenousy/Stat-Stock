@model Product
@{
    ViewData["Title"] = "Product Details";
}

<div class="mb-6">
    <a href="/Manager/Products" class="text-primary-600 hover:text-primary-800 inline-flex items-center">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Products
    </a>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="p-6 border-b border-gray-200">
        <div class="flex justify-between items-start">
            <div>
                <h2 class="text-2xl font-bold text-gray-900">@Model.Name</h2>
                <p class="text-gray-500 mt-1">SKU: @Model.SKU</p>
            </div>
            <div>
                @if (Model.StockQuantity <= Model.ReorderLevel)
                {
                    <span class="px-3 py-1 text-sm rounded-full bg-red-100 text-red-800">Low Stock</span>
                }
                else if (Model.StockQuantity <= Model.ReorderLevel * 2)
                {
                    <span class="px-3 py-1 text-sm rounded-full bg-yellow-100 text-yellow-800">Warning</span>
                }
                else
                {
                    <span class="px-3 py-1 text-sm rounded-full bg-green-100 text-green-800">In Stock</span>
                }
            </div>
        </div>
    </div>

    <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Product Information</h3>
                <dl class="space-y-4">
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Description</dt>
                        <dd class="mt-1 text-sm text-gray-900">@Model.Description</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Category</dt>
                        <dd class="mt-1">
                            <span class="px-2 py-1 text-sm rounded-full bg-blue-100 text-blue-800">@Model.Category</span>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Price</dt>
                        <dd class="mt-1 text-lg font-bold text-gray-900">$@Model.Price.ToString("N2")</dd>
                    </div>
                </dl>
            </div>

            <div>
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Stock Information</h3>
                <dl class="space-y-4">
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Current Stock</dt>
                        <dd class="mt-1">
                            <span class="text-2xl font-bold @(Model.StockQuantity <= Model.ReorderLevel ? "text-red-600" : "text-gray-900")">
                                @Model.StockQuantity
                            </span>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Reorder Level</dt>
                        <dd class="mt-1 text-lg text-gray-900">@Model.ReorderLevel</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Total Value</dt>
                        <dd class="mt-1 text-lg font-bold text-gray-900">$@((Model.Price * Model.StockQuantity).ToString("N2"))</dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="mt-6 pt-6 border-t border-gray-200">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Timeline</h3>
            <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <dt class="text-sm font-medium text-gray-500">Created At</dt>
                    <dd class="mt-1 text-sm text-gray-900">@Model.CreatedAt.ToString("MMMM dd, yyyy 'at' h:mm tt")</dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Last Updated</dt>
                    <dd class="mt-1 text-sm text-gray-900">@Model.UpdatedAt.ToString("MMMM dd, yyyy 'at' h:mm tt")</dd>
                </div>
            </dl>
        </div>
    </div>
</div>
