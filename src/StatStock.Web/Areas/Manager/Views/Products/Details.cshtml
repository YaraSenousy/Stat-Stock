@model Product
@{
    ViewData["Title"] = "Product Details";
}

<!-- Back Button -->
<div class="mb-6">
    <a href="/Manager/Products" class="inline-flex items-center px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-800 bg-white rounded-xl border border-slate-200 hover:border-slate-300 shadow-sm transition-all">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Products
    </a>
</div>

<!-- Main Card -->
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <!-- Header -->
    <div class="p-8 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white">
        <div class="flex items-start justify-between">
            <div class="flex items-center space-x-4">
                <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center shadow-lg shadow-primary-500/30">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">@Model.Name</h1>
                    <p class="text-slate-500 font-mono text-sm mt-1">SKU: @Model.SKU</p>
                </div>
            </div>
            <div>
                @if (Model.StockQuantity <= Model.ReorderLevel)
                {
                    <span class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold bg-red-100 text-red-800 shadow-sm">
                        ⚠️ Low Stock
                    </span>
                }
                else if (Model.StockQuantity <= Model.ReorderLevel * 2)
                {
                    <span class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold bg-amber-100 text-amber-800 shadow-sm">
                        ⚡ Warning
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold bg-emerald-100 text-emerald-800 shadow-sm">
                        ✓ In Stock
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="p-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Product Information -->
            <div class="bg-slate-50 rounded-2xl p-6">
                <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Product Information
                </h3>
                <dl class="space-y-5">
                    <div>
                        <dt class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Description</dt>
                        <dd class="mt-2 text-slate-800">@Model.Description</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Category</dt>
                        <dd class="mt-2">
                            <span class="inline-flex items-center px-3 py-1 rounded-lg text-sm font-medium bg-primary-100 text-primary-800">
                                @Model.Category
                            </span>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Unit Price</dt>
                        <dd class="mt-2 text-2xl font-bold text-slate-900">$@Model.Price.ToString("N2")</dd>
                    </div>
                </dl>
            </div>

            <!-- Stock Information -->
            <div class="bg-slate-50 rounded-2xl p-6">
                <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                    Stock Information
                </h3>
                <dl class="space-y-5">
                    <div>
                        <dt class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Current Stock</dt>
                        <dd class="mt-2">
                            <span class="text-4xl font-bold @(Model.StockQuantity <= Model.ReorderLevel ? "text-red-600" : "text-slate-900")">
                                @Model.StockQuantity
                            </span>
                            <span class="text-slate-500 ml-2">units</span>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Reorder Level</dt>
                        <dd class="mt-2 text-lg text-slate-700">@Model.ReorderLevel units</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-semibold text-slate-500 uppercase tracking-wide">Total Value</dt>
                        <dd class="mt-2 text-2xl font-bold text-emerald-600">$@((Model.Price * Model.StockQuantity).ToString("N2"))</dd>
                    </div>
                </dl>
            </div>
        </div>

        <!-- Timeline -->
        <div class="mt-8 pt-8 border-t border-slate-200">
            <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Timeline
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="flex items-center space-x-4 p-4 bg-slate-50 rounded-xl">
                    <div class="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center">
                        <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-slate-700">Created</p>
                        <p class="text-sm text-slate-500">@Model.CreatedAt.ToString("MMMM dd, yyyy 'at' h:mm tt")</p>
                    </div>
                </div>
                <div class="flex items-center space-x-4 p-4 bg-slate-50 rounded-xl">
                    <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-slate-700">Last Updated</p>
                        <p class="text-sm text-slate-500">@Model.UpdatedAt.ToString("MMMM dd, yyyy 'at' h:mm tt")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
