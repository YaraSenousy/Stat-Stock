@model Product
@{
    ViewData["Title"] = "Edit Product";
}

<!-- Back Button -->
<div class="mb-6">
    <a href="/Manager/Products" class="inline-flex items-center px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-800 bg-white rounded-xl border border-slate-200 hover:border-slate-300 shadow-sm transition-all">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Products
    </a>
</div>

<!-- Form Card -->
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <!-- Header -->
    <div class="p-8 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white">
        <div class="flex items-center space-x-4">
            <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center shadow-lg shadow-primary-500/30">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Edit Product</h1>
                <p class="text-slate-500 text-sm mt-1">Update product information</p>
            </div>
        </div>
    </div>

    <!-- Form Content -->
    <div class="p-8">
        <form asp-action="Edit" method="post" class="space-y-8">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            
            <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-xl mb-6"></div>

            <!-- Basic Information Section -->
            <div class="bg-slate-50 rounded-2xl p-6">
                <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Basic Information
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- SKU -->
                    <div>
                        <label asp-for="SKU" class="block text-sm font-semibold text-slate-700 mb-2">SKU *</label>
                        <input asp-for="SKU" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition" placeholder="e.g., PROD-001" />
                        <span asp-validation-for="SKU" class="text-red-600 text-sm mt-1 block"></span>
                    </div>

                    <!-- Name -->
                    <div>
                        <label asp-for="Name" class="block text-sm font-semibold text-slate-700 mb-2">Product Name *</label>
                        <input asp-for="Name" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition" placeholder="e.g., Wireless Mouse" />
                        <span asp-validation-for="Name" class="text-red-600 text-sm mt-1 block"></span>
                    </div>

                    <!-- Description -->
                    <div class="md:col-span-2">
                        <label asp-for="Description" class="block text-sm font-semibold text-slate-700 mb-2">Description</label>
                        <textarea asp-for="Description" rows="4" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition" placeholder="Enter product description..."></textarea>
                        <span asp-validation-for="Description" class="text-red-600 text-sm mt-1 block"></span>
                    </div>

                    <!-- Category -->
                    <div>
                        <label asp-for="Category" class="block text-sm font-semibold text-slate-700 mb-2">Category *</label>
                        <input asp-for="Category" list="categories" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition" placeholder="Select or enter category" />
                        <datalist id="categories">
                            @foreach (var category in ViewBag.Categories ?? new List<string>())
                            {
                                <option value="@category"></option>
                            }
                        </datalist>
                        <span asp-validation-for="Category" class="text-red-600 text-sm mt-1 block"></span>
                    </div>

                    <!-- Price -->
                    <div>
                        <label asp-for="Price" class="block text-sm font-semibold text-slate-700 mb-2">Unit Price *</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">$</span>
                            <input asp-for="Price" type="number" step="0.01" min="0" class="w-full pl-8 pr-4 py-2.5 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Price" class="text-red-600 text-sm mt-1 block"></span>
                    </div>
                </div>
            </div>

            <!-- Inventory Section -->
            <div class="bg-slate-50 rounded-2xl p-6">
                <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                    Inventory Settings
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Stock Quantity -->
                    <div>
                        <label asp-for="StockQuantity" class="block text-sm font-semibold text-slate-700 mb-2">Current Stock Quantity *</label>
                        <input asp-for="StockQuantity" type="number" min="0" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition" placeholder="0" />
                        <span asp-validation-for="StockQuantity" class="text-red-600 text-sm mt-1 block"></span>
                    </div>

                    <!-- Reorder Level -->
                    <div>
                        <label asp-for="ReorderLevel" class="block text-sm font-semibold text-slate-700 mb-2">Reorder Level *</label>
                        <input asp-for="ReorderLevel" type="number" min="0" class="w-full px-4 py-2.5 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition" placeholder="10" />
                        <span asp-validation-for="ReorderLevel" class="text-red-600 text-sm mt-1 block"></span>
                        <p class="text-xs text-slate-500 mt-1">Alert when stock falls below this level</p>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-between pt-6 border-t border-slate-200">
                <a href="/Manager/Products/Delete/@Model.Id" class="px-6 py-2.5 border border-red-300 text-red-700 font-medium rounded-xl hover:bg-red-50 transition-all">
                    Delete Product
                </a>
                <div class="flex items-center space-x-4">
                    <a href="/Manager/Products" class="px-6 py-2.5 border border-slate-300 text-slate-700 font-medium rounded-xl hover:bg-slate-50 transition-all">
                        Cancel
                    </a>
                    <button type="submit" class="px-6 py-2.5 bg-gradient-to-r from-primary-600 to-primary-700 text-white font-semibold rounded-xl hover:from-primary-700 hover:to-primary-800 transition-all shadow-lg shadow-primary-500/30">
                        Save Changes
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
