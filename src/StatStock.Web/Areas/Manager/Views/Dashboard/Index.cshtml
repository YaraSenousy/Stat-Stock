@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Stats Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
    <!-- Total Products -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-slate-500 text-sm font-medium">Total Products</p>
                <p class="text-3xl font-bold text-slate-800 mt-1">@Model.TotalProducts</p>
                <p class="text-xs text-emerald-600 mt-2 flex items-center">
                    <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
                    Active inventory
                </p>
            </div>
            <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl flex items-center justify-center shadow-lg shadow-blue-500/30">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
            </div>
        </div>
    </div>

    <!-- Total Orders -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-slate-500 text-sm font-medium">Total Orders</p>
                <p class="text-3xl font-bold text-slate-800 mt-1">@Model.TotalOrders</p>
                <p class="text-xs text-slate-500 mt-2">All time orders</p>
            </div>
            <div class="w-14 h-14 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl flex items-center justify-center shadow-lg shadow-emerald-500/30">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                </svg>
            </div>
        </div>
    </div>

    <!-- Pending Orders -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-slate-500 text-sm font-medium">Pending Orders</p>
                <p class="text-3xl font-bold text-slate-800 mt-1">@Model.PendingOrders</p>
                <a href="/Manager/Orders?status=Pending" class="text-xs text-amber-600 mt-2 flex items-center hover:text-amber-700">
                    Review now →
                </a>
            </div>
            <div class="w-14 h-14 bg-gradient-to-br from-amber-500 to-amber-600 rounded-2xl flex items-center justify-center shadow-lg shadow-amber-500/30">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
        </div>
    </div>

    <!-- Low Stock Items -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 hover:shadow-md transition-shadow @(Model.LowStockProducts > 0 ? "ring-2 ring-red-100" : "")">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-slate-500 text-sm font-medium">Low Stock Items</p>
                <p class="text-3xl font-bold @(Model.LowStockProducts > 0 ? "text-red-600" : "text-slate-800") mt-1">@Model.LowStockProducts</p>
                <p class="text-xs @(Model.LowStockProducts > 0 ? "text-red-500" : "text-emerald-600") mt-2 flex items-center">
                    @(Model.LowStockProducts > 0 ? "⚠️ Needs attention" : "✓ All stocked")
                </p>
            </div>
            <div class="w-14 h-14 bg-gradient-to-br from-red-500 to-red-600 rounded-2xl flex items-center justify-center shadow-lg shadow-red-500/30">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
            </div>
        </div>
    </div>

    <!-- Total Stock Value -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 hover:shadow-md transition-shadow">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-slate-500 text-sm font-medium">Stock Value</p>
                <p class="text-3xl font-bold text-slate-800 mt-1">$@Model.TotalStockValue.ToString("N0")</p>
                <p class="text-xs text-slate-500 mt-2">Total inventory value</p>
            </div>
            <div class="w-14 h-14 bg-gradient-to-br from-violet-500 to-violet-600 rounded-2xl flex items-center justify-center shadow-lg shadow-violet-500/30">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-bold text-slate-800">Inventory by Category</h3>
            <span class="text-xs text-slate-400">Distribution</span>
        </div>
        <div class="h-64">
            <canvas id="inventoryChart"></canvas>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-bold text-slate-800">Order Trends</h3>
            <span class="text-xs text-slate-400">Last 30 Days</span>
        </div>
        <div class="h-64">
            <canvas id="orderTrendsChart"></canvas>
        </div>
    </div>
</div>

<!-- Recent Orders and Low Stock -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Recent Orders -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <div>
                <h3 class="text-lg font-bold text-slate-800">Recent Orders</h3>
                <p class="text-sm text-slate-500">Latest activity</p>
            </div>
            <a href="/Manager/Orders" class="text-sm text-primary-600 hover:text-primary-700 font-medium">View all →</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Order #</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Type</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Date</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4">
                                <a href="/Manager/Orders/Details/@order.Id" class="text-sm font-semibold text-primary-600 hover:text-primary-700">@order.OrderNumber</a>
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @(order.Type == OrderType.Incoming ? "bg-emerald-100 text-emerald-800" : "bg-blue-100 text-blue-800")">
                                    @(order.Type == OrderType.Incoming ? "↓ Incoming" : "↑ Outgoing")
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @GetStatusClass(order.Status)">
                                    @order.Status
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-500">@order.CreatedAt.ToString("MMM dd")</td>
                        </tr>
                    }
                    @if (!Model.RecentOrders.Any())
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-slate-400">
                                <svg class="mx-auto h-12 w-12 text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                                </svg>
                                No recent orders
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Low Stock Alert -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden @(Model.LowStockItems.Any() ? "ring-2 ring-red-100" : "")">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                @if (Model.LowStockItems.Any())
                {
                    <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center">
                        <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                    </div>
                }
                <div>
                    <h3 class="text-lg font-bold text-slate-800">Low Stock Alert</h3>
                    <p class="text-sm @(Model.LowStockItems.Any() ? "text-red-500" : "text-slate-500")">
                        @(Model.LowStockItems.Any() ? $"{Model.LowStockItems.Count()} items need restocking" : "All items stocked")
                    </p>
                </div>
            </div>
            <a href="/Manager/Products" class="text-sm text-primary-600 hover:text-primary-700 font-medium">View all →</a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Product</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Current</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Reorder At</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var product in Model.LowStockItems)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4">
                                <a href="/Manager/Products/Details/@product.Id" class="text-sm font-semibold text-primary-600 hover:text-primary-700">@product.Name</a>
                                <p class="text-xs text-slate-400 font-mono">@product.SKU</p>
                            </td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center px-2 py-1 rounded-md text-sm font-bold bg-red-100 text-red-700">
                                    @product.StockQuantity
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-500">@product.ReorderLevel</td>
                        </tr>
                    }
                    @if (!Model.LowStockItems.Any())
                    {
                        <tr>
                            <td colspan="3" class="px-6 py-12 text-center text-slate-400">
                                <svg class="mx-auto h-12 w-12 text-emerald-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                All products are well stocked!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Inventory by Category Chart
        fetch('/Manager/Dashboard/GetInventoryStats')
            .then(response => response.json())
            .then(data => {
                const ctx = document.getElementById('inventoryChart').getContext('2d');
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: data.map(d => d.category),
                        datasets: [{
                            label: 'Products by Category',
                            data: data.map(d => d.count),
                            backgroundColor: [
                                'rgba(59, 130, 246, 0.8)',
                                'rgba(16, 185, 129, 0.8)',
                                'rgba(251, 191, 36, 0.8)',
                                'rgba(239, 68, 68, 0.8)',
                                'rgba(139, 92, 246, 0.8)'
                            ]
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }
                });
            });

        // Order Trends Chart
        fetch('/Manager/Dashboard/GetOrderTrends')
            .then(response => response.json())
            .then(data => {
                const ctx = document.getElementById('orderTrendsChart').getContext('2d');
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: data.map(d => new Date(d.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })),
                        datasets: [
                            {
                                label: 'Incoming',
                                data: data.map(d => d.incoming),
                                borderColor: 'rgba(16, 185, 129, 1)',
                                backgroundColor: 'rgba(16, 185, 129, 0.1)',
                                fill: true
                            },
                            {
                                label: 'Outgoing',
                                data: data.map(d => d.outgoing),
                                borderColor: 'rgba(59, 130, 246, 1)',
                                backgroundColor: 'rgba(59, 130, 246, 0.1)',
                                fill: true
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
            });

        // SignalR for real-time updates
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/dashboardHub")
            .build();

        connection.on("ReceiveDashboardUpdate", function (message) {
            console.log("Dashboard update:", message);
            // Reload page on dashboard updates
            location.reload();
        });

        connection.on("ReceiveStockAlert", function (productName, currentStock) {
            console.log(`Stock alert: ${productName} - ${currentStock} units`);
            // You could show a notification here
            alert(`Low stock alert: ${productName} has only ${currentStock} units remaining!`);
        });

        connection.on("ReceiveOrderUpdate", function (orderNumber, status) {
            console.log(`Order ${orderNumber} status changed to ${status}`);
            // Reload page on order updates
            location.reload();
        });

        connection.start()
            .then(() => console.log("SignalR connected"))
            .catch(err => console.error("SignalR error:", err));
    </script>
}

@functions {
    string GetStatusClass(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "bg-amber-100 text-amber-800",
            OrderStatus.Approved => "bg-emerald-100 text-emerald-800",
            OrderStatus.Shipped => "bg-blue-100 text-blue-800",
            OrderStatus.Delivered => "bg-violet-100 text-violet-800",
            OrderStatus.Cancelled => "bg-red-100 text-red-800",
            _ => "bg-slate-100 text-slate-800"
        };
    }
}
