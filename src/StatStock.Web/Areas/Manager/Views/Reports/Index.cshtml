@{
    ViewData["Title"] = "Reports & Analytics";
}

<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8">Reports & Analytics</h1>

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            @TempData["Error"]
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Stock Movement Report -->
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition">
            <div class="flex items-center mb-4">
                <svg class="w-12 h-12 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
                <h2 class="text-xl font-semibold ml-4">Stock Movement</h2>
            </div>
            <p class="text-gray-600 mb-4">Track product stock changes over time with incoming and outgoing movements.</p>
            <a href="@Url.Action("StockMovement")" class="inline-block bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">
                View Report
            </a>
        </div>

        <!-- Inventory Valuation Report -->
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition">
            <div class="flex items-center mb-4">
                <svg class="w-12 h-12 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <h2 class="text-xl font-semibold ml-4">Inventory Valuation</h2>
            </div>
            <p class="text-gray-600 mb-4">Complete inventory valuation report showing total stock value by product.</p>
            <a href="@Url.Action("InventoryValuation")" class="inline-block bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600">
                View Report
            </a>
        </div>

        <!-- Low Stock Report -->
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition">
            <div class="flex items-center mb-4">
                <svg class="w-12 h-12 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                <h2 class="text-xl font-semibold ml-4">Low Stock Items</h2>
            </div>
            <p class="text-gray-600 mb-4">Products below reorder level with recommended order quantities.</p>
            <a href="@Url.Action("LowStock")" class="inline-block bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600">
                View Report
            </a>
        </div>

        <!-- Sales Trends Report -->
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition">
            <div class="flex items-center mb-4">
                <svg class="w-12 h-12 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
                <h2 class="text-xl font-semibold ml-4">Sales Trends</h2>
            </div>
            <p class="text-gray-600 mb-4">Analyze order trends and values over time for business insights.</p>
            <a href="@Url.Action("SalesTrends")" class="inline-block bg-purple-500 text-white px-4 py-2 rounded hover:bg-purple-600">
                View Report
            </a>
        </div>

        <!-- Demand Forecast -->
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition">
            <div class="flex items-center mb-4">
                <svg class="w-12 h-12 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <h2 class="text-xl font-semibold ml-4">Demand Forecast</h2>
            </div>
            <p class="text-gray-600 mb-4">AI-powered demand forecasting to predict future inventory needs.</p>
            <a href="@Url.Action("DemandForecast")" class="inline-block bg-indigo-500 text-white px-4 py-2 rounded hover:bg-indigo-600">
                View Forecast
            </a>
        </div>

        <!-- Reorder Suggestions -->
        <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition">
            <div class="flex items-center mb-4">
                <svg class="w-12 h-12 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                </svg>
                <h2 class="text-xl font-semibold ml-4">Reorder Suggestions</h2>
            </div>
            <p class="text-gray-600 mb-4">Smart reorder recommendations based on stock levels and demand.</p>
            <a href="@Url.Action("ReorderSuggestions")" class="inline-block bg-orange-500 text-white px-4 py-2 rounded hover:bg-orange-600">
                View Suggestions
            </a>
        </div>
    </div>

    <!-- Quick Stats Summary -->
    <div class="mt-12">
        <h2 class="text-2xl font-bold mb-6">Quick Stats</h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg shadow-md p-6 text-white">
                <div class="text-3xl font-bold mb-2" id="totalProducts">Loading...</div>
                <div class="text-blue-100">Total Products</div>
            </div>
            <div class="bg-gradient-to-br from-green-500 to-green-600 rounded-lg shadow-md p-6 text-white">
                <div class="text-3xl font-bold mb-2" id="totalValue">Loading...</div>
                <div class="text-green-100">Total Inventory Value</div>
            </div>
            <div class="bg-gradient-to-br from-red-500 to-red-600 rounded-lg shadow-md p-6 text-white">
                <div class="text-3xl font-bold mb-2" id="lowStockCount">Loading...</div>
                <div class="text-red-100">Low Stock Items</div>
            </div>
            <div class="bg-gradient-to-br from-purple-500 to-purple-600 rounded-lg shadow-md p-6 text-white">
                <div class="text-3xl font-bold mb-2" id="ordersThisMonth">Loading...</div>
                <div class="text-purple-100">Orders This Month</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load quick stats on page load
        document.addEventListener('DOMContentLoaded', async () => {
            try {
                const response = await fetch('/Manager/Dashboard/GetInventoryStats');
                if (!response.ok) return;
                
                const stats = await response.json();
                
                // Update stats (this is a simplified version - adjust based on actual API)
                document.getElementById('totalProducts').textContent = stats.reduce((sum, s) => sum + s.Count, 0);
                document.getElementById('totalValue').textContent = '$' + stats.reduce((sum, s) => sum + s.TotalValue, 0).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            } catch (error) {
                console.error('Error loading stats:', error);
            }
        });
    </script>
}
