@model StatStock.Web.Areas.Manager.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="max-w-2xl">
    <div class="mb-6">
        <a asp-action="Index" class="inline-flex items-center text-primary-600 hover:text-primary-700 font-medium">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Back to Users
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200">
        <div class="border-b border-slate-200 px-6 py-4">
            <h3 class="text-xl font-bold text-slate-800">Change Password</h3>
            <p class="text-sm text-slate-600 mt-1">Reset password for @Model.Email</p>
        </div>
        
        <div class="p-6">
            <form asp-action="ChangePassword" method="post" class="space-y-6">
                <input asp-for="UserId" type="hidden" />
                <input asp-for="Email" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg"></div>
                
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-2">User Email</label>
                    <input value="@Model.Email" class="w-full px-4 py-2 bg-slate-100 border border-slate-300 rounded-lg cursor-not-allowed" readonly />
                </div>
                
                <div>
                    <label asp-for="NewPassword" class="block text-sm font-medium text-slate-700 mb-2"></label>
                    <input asp-for="NewPassword" type="password" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                    <span asp-validation-for="NewPassword" class="text-red-600 text-sm mt-1 block"></span>
                    <p class="text-xs text-slate-500 mt-1">Must be at least 6 characters with uppercase, lowercase, digit, and special character</p>
                </div>
                
                <div>
                    <label asp-for="ConfirmPassword" class="block text-sm font-medium text-slate-700 mb-2"></label>
                    <input asp-for="ConfirmPassword" type="password" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                    <span asp-validation-for="ConfirmPassword" class="text-red-600 text-sm mt-1 block"></span>
                </div>
                
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200">
                    <a asp-action="Index" class="px-6 py-2 border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-lg font-medium">Cancel</a>
                    <button type="submit" class="px-6 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg shadow-sm font-medium">Change Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
