@model StatStock.Web.Areas.Manager.Models.EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="max-w-3xl">
    <div class="mb-6">
        <a asp-action="Index" class="inline-flex items-center text-primary-600 hover:text-primary-700 font-medium">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Back to Users
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200">
        <div class="border-b border-slate-200 px-6 py-4">
            <h3 class="text-xl font-bold text-slate-800">Edit User</h3>
            <p class="text-sm text-slate-600 mt-1">Update user information</p>
        </div>
        
        <div class="p-6">
            <form asp-action="Edit" method="post" class="space-y-6">
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg"></div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="FirstName" class="block text-sm font-medium text-slate-700 mb-2"></label>
                        <input asp-for="FirstName" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                        <span asp-validation-for="FirstName" class="text-red-600 text-sm mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="LastName" class="block text-sm font-medium text-slate-700 mb-2"></label>
                        <input asp-for="LastName" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                        <span asp-validation-for="LastName" class="text-red-600 text-sm mt-1 block"></span>
                    </div>
                </div>
                
                <div>
                    <label asp-for="Email" class="block text-sm font-medium text-slate-700 mb-2"></label>
                    <input asp-for="Email" type="email" class="w-full px-4 py-2 bg-slate-100 border border-slate-300 rounded-lg cursor-not-allowed" readonly />
                    <p class="text-xs text-slate-500 mt-1">Email cannot be changed</p>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="Role" class="block text-sm font-medium text-slate-700 mb-2"></label>
                        <select asp-for="Role" asp-items="Html.GetEnumSelectList<StatStock.Domain.Enums.UserRole>()" 
                                class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"></select>
                        <span asp-validation-for="Role" class="text-red-600 text-sm mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Area" class="block text-sm font-medium text-slate-700 mb-2"></label>
                        <input asp-for="Area" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
                        <span asp-validation-for="Area" class="text-red-600 text-sm mt-1 block"></span>
                    </div>
                </div>
                
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200">
                    <a asp-action="Index" class="px-6 py-2 border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-lg font-medium">Cancel</a>
                    <button type="submit" class="px-6 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg shadow-sm font-medium">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
