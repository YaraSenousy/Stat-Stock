@model StatStock.Web.Areas.Manager.Models.UserViewModel
@{
    ViewData["Title"] = "Delete User";
}

<div class="max-w-2xl">
    <div class="mb-6">
        <a asp-action="Index" class="inline-flex items-center text-primary-600 hover:text-primary-700 font-medium">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Back to Users
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-red-200">
        <div class="border-b border-red-200 px-6 py-4 bg-red-50">
            <div class="flex items-center">
                <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-red-800">Delete User</h3>
                    <p class="text-sm text-red-700 mt-1">This action cannot be undone</p>
                </div>
            </div>
        </div>
        
        <div class="p-6">
            <div class="bg-slate-50 rounded-lg p-4 mb-6">
                <h4 class="font-semibold text-slate-800 mb-3">User Details</h4>
                <dl class="space-y-2">
                    <div class="flex"><dt class="font-medium text-slate-600 w-24">Email:</dt><dd class="text-slate-800">@Model.Email</dd></div>
                    <div class="flex"><dt class="font-medium text-slate-600 w-24">Name:</dt><dd class="text-slate-800">@Model.FirstName @Model.LastName</dd></div>
                    <div class="flex"><dt class="font-medium text-slate-600 w-24">Role:</dt><dd><span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full @(Model.Role switch { StatStock.Domain.Enums.UserRole.Admin => "bg-red-100 text-red-800", StatStock.Domain.Enums.UserRole.Manager => "bg-blue-100 text-blue-800", _ => "bg-slate-100 text-slate-800" })">@Model.Role</span></dd></div>
                    <div class="flex"><dt class="font-medium text-slate-600 w-24">Area:</dt><dd class="text-slate-800">@(Model.Area ?? "N/A")</dd></div>
                    <div class="flex"><dt class="font-medium text-slate-600 w-24">Created:</dt><dd class="text-slate-800">@Model.CreatedAt.ToString("MMMM dd, yyyy")</dd></div>
                </dl>
            </div>
            
            <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6">
                <p class="text-amber-800 text-sm">Are you sure you want to delete this user? All data associated with this account will be permanently removed.</p>
            </div>
            
            <form asp-action="Delete" method="post">
                <input asp-for="Id" type="hidden" />
                <div class="flex items-center justify-end gap-3">
                    <a asp-action="Index" class="px-6 py-2 border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-lg font-medium">Cancel</a>
                    <button type="submit" class="px-6 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg shadow-sm font-medium">Delete User</button>
                </div>
            </form>
        </div>
    </div>
</div>
