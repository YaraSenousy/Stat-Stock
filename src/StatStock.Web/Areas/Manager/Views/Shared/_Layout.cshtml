<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StatStock Manager</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            200: '#bfdbfe',
                            300: '#93c5fd',
                            400: '#60a5fa',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <!-- SignalR -->
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
    <style>
        /* Custom scrollbar - thinner and better colored for dark theme */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.2); border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.3); }
        
        /* Hide scrollbar for Chrome, Safari and Opera but keep functionality */
        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }
        /* Hide scrollbar for IE, Edge and Firefox */
        .scrollbar-hide {
            -ms-overflow-style: none;  /* IE and Edge */
            scrollbar-width: none;  /* Firefox */
        }
        
        /* Toast animation */
        @@keyframes slideIn {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }
        .animate-slideIn {
            animation: slideIn 0.3s ease-out;
        }
        
        /* Focus visible for accessibility */
        .nav-link:focus-visible {
            outline: 2px solid white;
            outline-offset: 2px;
        }
    </style>
</head>
<body class="bg-slate-100 min-h-screen">
    <div class="flex min-h-screen">
        <!-- Sidebar -->
        <aside class="w-56 lg:w-64 bg-gradient-to-b from-primary-800 to-primary-900 text-white fixed h-full shadow-xl flex flex-col" role="navigation" aria-label="Main navigation">
            <!-- Logo -->
            <div class="p-4 lg:p-5 border-b border-primary-700/50 flex-shrink-0">
                <div class="flex items-center space-x-2">
                    <div class="w-9 h-9 bg-white/10 rounded-lg flex items-center justify-center flex-shrink-0">
                        <svg class="w-5 h-5 text-primary-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                        </svg>
                    </div>
                    <div class="min-w-0">
                        <h1 class="text-lg font-bold tracking-tight truncate">StatStock</h1>
                        <p class="text-primary-300 text-xs truncate">Inventory Management</p>
                    </div>
                </div>
            </div>

            <!-- Navigation - Flex grow to take available space -->
            <nav class="flex-1 px-2 lg:px-3 py-3 overflow-y-auto scrollbar-hide" aria-label="Main menu">
                <p class="text-xs font-semibold text-primary-400 uppercase tracking-wider px-2 mb-2">Menu</p>
                
                <a href="/Manager/Dashboard" 
                   class="nav-link flex items-center px-3 py-2.5 mb-0.5 rounded-lg transition-all duration-200 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "bg-white/10 text-white shadow-lg" : "text-primary-200 hover:bg-white/5 hover:text-white")"
                   aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "page" : null)">
                    <svg class="w-5 h-5 mr-2.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                    </svg>
                    <span class="font-medium text-sm">Dashboard</span>
                </a>

                <a href="/Manager/Products" 
                   class="nav-link flex items-center px-3 py-2.5 mb-0.5 rounded-lg transition-all duration-200 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "bg-white/10 text-white shadow-lg" : "text-primary-200 hover:bg-white/5 hover:text-white")"
                   aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "page" : null)">
                    <svg class="w-5 h-5 mr-2.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                    </svg>
                    <span class="font-medium text-sm">Products</span>
                </a>

                <a href="/Manager/Orders" 
                   class="nav-link flex items-center px-3 py-2.5 mb-0.5 rounded-lg transition-all duration-200 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "bg-white/10 text-white shadow-lg" : "text-primary-200 hover:bg-white/5 hover:text-white")"
                   aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "page" : null)">
                    <svg class="w-5 h-5 mr-2.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                    </svg>
                    <span class="font-medium text-sm">Orders</span>
                </a>

                <a href="/Manager/Suppliers" 
                   class="nav-link flex items-center px-3 py-2.5 mb-0.5 rounded-lg transition-all duration-200 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Suppliers" ? "bg-white/10 text-white shadow-lg" : "text-primary-200 hover:bg-white/5 hover:text-white")"
                   aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Suppliers" ? "page" : null)">
                    <svg class="w-5 h-5 mr-2.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                    </svg>
                    <span class="font-medium text-sm">Suppliers</span>
                </a>

                <a href="/Manager/Categories" 
                   class="nav-link flex items-center px-3 py-2.5 mb-0.5 rounded-lg transition-all duration-200 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "bg-white/10 text-white shadow-lg" : "text-primary-200 hover:bg-white/5 hover:text-white")"
                   aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "page" : null)">
                    <svg class="w-5 h-5 mr-2.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                    </svg>
                    <span class="font-medium text-sm">Categories</span>
                </a>

                <a href="/Manager/Reports" 
                   class="nav-link flex items-center px-3 py-2.5 mb-0.5 rounded-lg transition-all duration-200 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "bg-white/10 text-white shadow-lg" : "text-primary-200 hover:bg-white/5 hover:text-white")"
                   aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "page" : null)">
                    <svg class="w-5 h-5 mr-2.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                    <span class="font-medium text-sm">Reports</span>
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <a href="/Manager/Users" 
                       class="nav-link flex items-center px-3 py-2.5 mb-0.5 rounded-lg transition-all duration-200 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "bg-white/10 text-white shadow-lg" : "text-primary-200 hover:bg-white/5 hover:text-white")"
                       aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "page" : null)">
                        <svg class="w-5 h-5 mr-2.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                        <span class="font-medium text-sm">Users</span>
                    </a>
                }

                <!-- Divider -->
                <div class="border-t border-primary-700/50 my-3"></div>
                
                <p class="text-xs font-semibold text-primary-400 uppercase tracking-wider px-2 mb-2">Quick Actions</p>
                <a href="/Manager/Orders?status=Pending" 
                   class="nav-link flex items-center px-3 py-2.5 mb-0.5 rounded-lg text-primary-200 hover:bg-white/5 hover:text-white transition-all duration-200">
                    <svg class="w-5 h-5 mr-2.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span class="font-medium text-sm">Pending Orders</span>
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <a href="/Terminal/Terminal/Index" 
                       class="nav-link flex items-center px-3 py-2.5 mb-0.5 rounded-lg text-primary-200 hover:bg-white/5 hover:text-white transition-all duration-200">
                        <svg class="w-5 h-5 mr-2.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                        </svg>
                        <span class="font-medium text-sm">Terminal</span>
                    </a>
                }
            </nav>

            <!-- User section removed from sidebar -->
        </aside>

        <!-- Main Content -->
        <div class="flex-1 ml-56 lg:ml-64">
            <!-- Top Bar -->
            <header class="bg-white shadow-sm sticky top-0 z-10">
                <div class="px-4 lg:px-8 py-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                    <div class="min-w-0">
                        <h2 class="text-xl lg:text-2xl font-bold text-slate-800 truncate">@ViewData["Title"]</h2>
                        <p class="text-sm text-slate-500">Welcome back! Here's what's happening today.</p>
                    </div>
                    <div class="flex items-center space-x-4 flex-shrink-0">
                        <!-- User Info -->
                        <div class="flex items-center space-x-3">
                            <div class="text-right hidden sm:block">
                                <p class="text-sm font-medium text-slate-700">@User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</p>
                                <p class="text-xs text-slate-500">@User.Identity?.Name</p>
                            </div>
                            <div class="w-10 h-10 bg-primary-600 rounded-full flex items-center justify-center flex-shrink-0 text-white shadow-md">
                                <span class="text-sm font-semibold">@(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")</span>
                            </div>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="inline-block">
                                <button type="submit" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all duration-200" title="Logout">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                                    </svg>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="p-4 lg:p-8" role="main">
                @RenderBody()
            </main>

            <!-- Notification Toast -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div id="successToast" class="fixed top-4 right-4 z-50 max-w-md" role="alert" aria-live="polite">
                    <div class="bg-white rounded-xl shadow-2xl border-l-4 border-emerald-500 p-4 flex items-start space-x-3 animate-slideIn">
                        <div class="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
                            <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                        <div class="flex-1">
                            <h4 class="text-sm font-bold text-slate-900 mb-1">Success</h4>
                            <p class="text-sm text-slate-600">@TempData["SuccessMessage"]</p>
                        </div>
                        <button onclick="document.getElementById('successToast').remove()" class="text-slate-400 hover:text-slate-600 focus:outline-none focus:ring-2 focus:ring-slate-400 rounded" aria-label="Dismiss notification">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                </div>
                <script>
                    setTimeout(() => {
                        const toast = document.getElementById('successToast');
                        if (toast) {
                            toast.style.transition = 'opacity 0.5s ease-out';
                            toast.style.opacity = '0';
                            setTimeout(() => toast.remove(), 500);
                        }
                    }, 5000);
                </script>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div id="errorToast" class="fixed top-4 right-4 z-50 max-w-md">
                    <div class="bg-white rounded-xl shadow-2xl border-l-4 border-red-500 p-4 flex items-start space-x-3 animate-slideIn">
                        <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center flex-shrink-0">
                            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <div class="flex-1">
                            <h4 class="text-sm font-bold text-slate-900 mb-1">Error</h4>
                            <p class="text-sm text-slate-600">@TempData["ErrorMessage"]</p>
                        </div>
                        <button onclick="document.getElementById('errorToast').remove()" class="text-slate-400 hover:text-slate-600">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                </div>
                <script>
                    setTimeout(() => {
                        const toast = document.getElementById('errorToast');
                        if (toast) {
                            toast.style.transition = 'opacity 0.5s ease-out';
                            toast.style.opacity = '0';
                            setTimeout(() => toast.remove(), 500);
                        }
                    }, 5000);
                </script>
            }

            @if (TempData["InfoMessage"] != null)
            {
                <div id="infoToast" class="fixed top-4 right-4 z-50 max-w-md">
                    <div class="bg-white rounded-xl shadow-2xl border-l-4 border-blue-500 p-4 flex items-start space-x-3 animate-slideIn">
                        <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0">
                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <div class="flex-1">
                            <h4 class="text-sm font-bold text-slate-900 mb-1">Information</h4>
                            <p class="text-sm text-slate-600">@TempData["InfoMessage"]</p>
                        </div>
                        <button onclick="document.getElementById('infoToast').remove()" class="text-slate-400 hover:text-slate-600">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                </div>
                <script>
                    setTimeout(() => {
                        const toast = document.getElementById('infoToast');
                        if (toast) {
                            toast.style.transition = 'opacity 0.5s ease-out';
                            toast.style.opacity = '0';
                            setTimeout(() => toast.remove(), 500);
                        }
                    }, 5000);
                </script>
            }

            <!-- Footer -->
            <footer class="px-4 lg:px-8 py-4 text-center text-sm text-slate-400 border-t bg-white" role="contentinfo">
                &copy; 2026 StatStock - Inventory Management Platform
            </footer>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
