@model Order
@{
    ViewData["Title"] = "Order Details";
}

<div class="mb-6">
    <a href="/Manager/Orders" class="text-primary-600 hover:text-primary-800 inline-flex items-center">
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Orders
    </a>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="p-6 border-b border-gray-200">
        <div class="flex justify-between items-start">
            <div>
                <h2 class="text-2xl font-bold text-gray-900">Order @Model.OrderNumber</h2>
                <p class="text-gray-500 mt-1">Created on @Model.CreatedAt.ToString("MMMM dd, yyyy 'at' h:mm tt")</p>
            </div>
            <div class="flex space-x-2">
                <span class="px-3 py-1 text-sm rounded-full @(Model.Type == OrderType.Incoming ? "bg-green-100 text-green-800" : "bg-blue-100 text-blue-800")">
                    @Model.Type
                </span>
                <span class="px-3 py-1 text-sm rounded-full @GetStatusClass(Model.Status)">
                    @Model.Status
                </span>
            </div>
        </div>
    </div>

    <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div>
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Order Information</h3>
                <dl class="space-y-3">
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Order Number</dt>
                        <dd class="mt-1 text-sm text-gray-900">@Model.OrderNumber</dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Type</dt>
                        <dd class="mt-1">
                            <span class="px-2 py-1 text-sm rounded-full @(Model.Type == OrderType.Incoming ? "bg-green-100 text-green-800" : "bg-blue-100 text-blue-800")">
                                @Model.Type
                            </span>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Status</dt>
                        <dd class="mt-1">
                            <span class="px-2 py-1 text-sm rounded-full @GetStatusClass(Model.Status)">
                                @Model.Status
                            </span>
                        </dd>
                    </div>
                </dl>
            </div>

            <div>
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Supplier Information</h3>
                @if (Model.Supplier != null)
                {
                    <dl class="space-y-3">
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Name</dt>
                            <dd class="mt-1 text-sm text-gray-900">@Model.Supplier.Name</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Contact</dt>
                            <dd class="mt-1 text-sm text-gray-900">@Model.Supplier.Contact</dd>
                        </div>
                        <div>
                            <dt class="text-sm font-medium text-gray-500">Email</dt>
                            <dd class="mt-1 text-sm text-gray-900">@Model.Supplier.Email</dd>
                        </div>
                    </dl>
                }
                else
                {
                    <p class="text-sm text-gray-500">No supplier information available</p>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="mb-6 p-4 bg-gray-50 rounded-lg">
                <h4 class="text-sm font-medium text-gray-700 mb-2">Notes</h4>
                <p class="text-sm text-gray-600">@Model.Notes</p>
            </div>
        }

        <div class="mb-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Order Items</h3>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Product</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">SKU</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Quantity</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Unit Price</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Total</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="px-6 py-4 text-sm text-gray-900">@item.Product?.Name</td>
                                <td class="px-6 py-4 text-sm text-gray-600">@item.Product?.SKU</td>
                                <td class="px-6 py-4 text-sm text-gray-900">@item.Quantity</td>
                                <td class="px-6 py-4 text-sm text-gray-900">$@item.UnitPrice.ToString("N2")</td>
                                <td class="px-6 py-4 text-sm font-medium text-gray-900">$@((item.Quantity * item.UnitPrice).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-gray-50">
                        <tr>
                            <td colspan="4" class="px-6 py-4 text-right text-sm font-medium text-gray-900">Total:</td>
                            <td class="px-6 py-4 text-sm font-bold text-gray-900">
                                $@Model.Items.Sum(i => i.Quantity * i.UnitPrice).ToString("N2")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="border-t border-gray-200 pt-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Timeline</h3>
            <div class="space-y-3">
                <div class="flex items-center text-sm">
                    <span class="font-medium text-gray-700 w-32">Created:</span>
                    <span class="text-gray-600">@Model.CreatedAt.ToString("MMMM dd, yyyy 'at' h:mm tt")</span>
                </div>
                @if (Model.ApprovedAt.HasValue)
                {
                    <div class="flex items-center text-sm">
                        <span class="font-medium text-gray-700 w-32">Approved:</span>
                        <span class="text-gray-600">@Model.ApprovedAt.Value.ToString("MMMM dd, yyyy 'at' h:mm tt")</span>
                    </div>
                }
            </div>
        </div>

        @if (Model.Status == OrderStatus.Pending)
        {
            <div class="border-t border-gray-200 pt-6 mt-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Actions</h3>
                <div class="flex space-x-4">
                    <form method="post" asp-action="UpdateStatus" asp-route-id="@Model.Id" asp-route-status="@OrderStatus.Approved">
                        <button type="submit" class="bg-green-600 text-white px-6 py-2 rounded-md hover:bg-green-700 transition">
                            Approve Order
                        </button>
                    </form>
                    <form method="post" asp-action="UpdateStatus" asp-route-id="@Model.Id" asp-route-status="@OrderStatus.Cancelled">
                        <button type="submit" class="bg-red-600 text-white px-6 py-2 rounded-md hover:bg-red-700 transition">
                            Cancel Order
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@functions {
    string GetStatusClass(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "bg-yellow-100 text-yellow-800",
            OrderStatus.Approved => "bg-green-100 text-green-800",
            OrderStatus.Shipped => "bg-blue-100 text-blue-800",
            OrderStatus.Delivered => "bg-purple-100 text-purple-800",
            OrderStatus.Cancelled => "bg-red-100 text-red-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }
}
