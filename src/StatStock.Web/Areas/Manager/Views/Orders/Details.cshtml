@model Order
@{
    ViewData["Title"] = "Order Details";
}

<!-- Back Button -->
<div class="mb-6">
    <a href="/Manager/Orders" class="inline-flex items-center px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-800 bg-white rounded-xl border border-slate-200 hover:border-slate-300 shadow-sm transition-all">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Orders
    </a>
</div>

<!-- Main Card -->
<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <!-- Header -->
    <div class="p-8 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white">
        <div class="flex items-start justify-between">
            <div class="flex items-center space-x-4">
                <div class="w-16 h-16 bg-gradient-to-br @(Model.Type == OrderType.Incoming ? "from-emerald-500 to-emerald-600" : "from-blue-500 to-blue-600") rounded-2xl flex items-center justify-center shadow-lg @(Model.Type == OrderType.Incoming ? "shadow-emerald-500/30" : "shadow-blue-500/30")">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">Order @Model.OrderNumber</h1>
                    <p class="text-slate-500 text-sm mt-1">Created on @Model.CreatedAt.ToString("MMMM dd, yyyy 'at' h:mm tt")</p>
                </div>
            </div>
            <div class="flex items-center space-x-3">
                <span class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold @(Model.Type == OrderType.Incoming ? "bg-emerald-100 text-emerald-800" : "bg-blue-100 text-blue-800") shadow-sm">
                    @(Model.Type == OrderType.Incoming ? "↓ Incoming" : "↑ Outgoing")
                </span>
                <span class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold @GetStatusClass(Model.Status) shadow-sm">
                    @Model.Status
                </span>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="p-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <!-- Order Information -->
            <div class="bg-slate-50 rounded-2xl p-6">
                <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Order Information
                </h3>
                <dl class="space-y-4">
                    <div class="flex justify-between items-center py-2 border-b border-slate-200">
                        <dt class="text-sm font-medium text-slate-500">Order Number</dt>
                        <dd class="text-sm font-semibold text-slate-900 font-mono">@Model.OrderNumber</dd>
                    </div>
                    <div class="flex justify-between items-center py-2 border-b border-slate-200">
                        <dt class="text-sm font-medium text-slate-500">Type</dt>
                        <dd>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium @(Model.Type == OrderType.Incoming ? "bg-emerald-100 text-emerald-800" : "bg-blue-100 text-blue-800")">
                                @Model.Type
                            </span>
                        </dd>
                    </div>
                    <div class="flex justify-between items-center py-2">
                        <dt class="text-sm font-medium text-slate-500">Status</dt>
                        <dd>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium @GetStatusClass(Model.Status)">
                                @Model.Status
                            </span>
                        </dd>
                    </div>
                </dl>
            </div>

            <!-- Supplier Information -->
            <div class="bg-slate-50 rounded-2xl p-6">
                <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                    </svg>
                    Supplier Information
                </h3>
                @if (Model.Supplier != null)
                {
                    <dl class="space-y-4">
                        <div class="flex justify-between items-center py-2 border-b border-slate-200">
                            <dt class="text-sm font-medium text-slate-500">Company</dt>
                            <dd class="text-sm font-semibold text-slate-900">@Model.Supplier.Name</dd>
                        </div>
                        <div class="flex justify-between items-center py-2 border-b border-slate-200">
                            <dt class="text-sm font-medium text-slate-500">Contact</dt>
                            <dd class="text-sm text-slate-700">@Model.Supplier.Contact</dd>
                        </div>
                        <div class="flex justify-between items-center py-2">
                            <dt class="text-sm font-medium text-slate-500">Email</dt>
                            <dd class="text-sm text-primary-600">@Model.Supplier.Email</dd>
                        </div>
                    </dl>
                }
                else
                {
                    <div class="text-center py-8">
                        <div class="w-12 h-12 bg-slate-200 rounded-full flex items-center justify-center mx-auto mb-3">
                            <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                            </svg>
                        </div>
                        <p class="text-sm text-slate-500">No supplier information available</p>
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="mb-8 p-5 bg-amber-50 border border-amber-200 rounded-2xl">
                <div class="flex items-start space-x-3">
                    <svg class="w-5 h-5 text-amber-600 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
                    </svg>
                    <div>
                        <h4 class="text-sm font-semibold text-amber-800 mb-1">Notes</h4>
                        <p class="text-sm text-amber-700">@Model.Notes</p>
                    </div>
                </div>
            </div>
        }

        <!-- Order Items -->
        <div class="mb-8">
            <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
                Order Items
            </h3>
            <div class="bg-slate-50 rounded-2xl overflow-hidden border border-slate-200">
                <table class="w-full">
                    <thead class="bg-slate-100">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-bold text-slate-600 uppercase tracking-wider">Product</th>
                            <th class="px-6 py-4 text-left text-xs font-bold text-slate-600 uppercase tracking-wider">SKU</th>
                            <th class="px-6 py-4 text-center text-xs font-bold text-slate-600 uppercase tracking-wider">Qty</th>
                            <th class="px-6 py-4 text-right text-xs font-bold text-slate-600 uppercase tracking-wider">Unit Price</th>
                            <th class="px-6 py-4 text-right text-xs font-bold text-slate-600 uppercase tracking-wider">Total</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 bg-white">
                        @foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4 text-sm font-semibold text-slate-900">@item.Product?.Name</td>
                                <td class="px-6 py-4 text-sm text-slate-500 font-mono">@item.Product?.SKU</td>
                                <td class="px-6 py-4 text-center">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-sm font-semibold bg-slate-100 text-slate-700">
                                        @item.Quantity
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-sm text-right text-slate-700">$@item.UnitPrice.ToString("N2")</td>
                                <td class="px-6 py-4 text-sm text-right font-bold text-slate-900">$@((item.Quantity * item.UnitPrice).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-slate-100">
                        <tr>
                            <td colspan="4" class="px-6 py-4 text-right text-sm font-bold text-slate-700 uppercase">Grand Total</td>
                            <td class="px-6 py-4 text-right text-lg font-bold text-emerald-600">
                                $@Model.Items.Sum(i => i.Quantity * i.UnitPrice).ToString("N2")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Timeline -->
        <div class="border-t border-slate-200 pt-8">
            <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Timeline
            </h3>
            <div class="flex flex-wrap gap-4">
                <div class="flex items-center space-x-3 p-4 bg-slate-50 rounded-xl flex-1 min-w-[200px]">
                    <div class="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center">
                        <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase">Created</p>
                        <p class="text-sm font-medium text-slate-800">@Model.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</p>
                    </div>
                </div>
                @if (Model.ApprovedAt.HasValue)
                {
                    <div class="flex items-center space-x-3 p-4 bg-slate-50 rounded-xl flex-1 min-w-[200px]">
                        <div class="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center">
                            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-slate-500 uppercase">Approved</p>
                            <p class="text-sm font-medium text-slate-800">@Model.ApprovedAt.Value.ToString("MMM dd, yyyy h:mm tt")</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (Model.Status == OrderStatus.Pending)
        {
            <div class="border-t border-slate-200 pt-8 mt-8">
                <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                    Actions
                </h3>
                <div class="flex flex-wrap gap-4">
                    <form method="post" asp-action="UpdateStatus" asp-route-id="@Model.Id" asp-route-status="@OrderStatus.Approved">
                        <button type="submit" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white font-semibold rounded-xl shadow-lg shadow-emerald-500/30 hover:from-emerald-600 hover:to-emerald-700 transition-all">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            Approve Order
                        </button>
                    </form>
                    <form method="post" asp-action="UpdateStatus" asp-route-id="@Model.Id" asp-route-status="@OrderStatus.Cancelled">
                        <button type="submit" class="inline-flex items-center px-6 py-3 bg-white text-red-600 font-semibold rounded-xl border-2 border-red-200 hover:bg-red-50 hover:border-red-300 transition-all">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                            Cancel Order
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@functions {
    string GetStatusClass(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "bg-amber-100 text-amber-800",
            OrderStatus.Approved => "bg-emerald-100 text-emerald-800",
            OrderStatus.Shipped => "bg-blue-100 text-blue-800",
            OrderStatus.Delivered => "bg-violet-100 text-violet-800",
            OrderStatus.Cancelled => "bg-red-100 text-red-800",
            _ => "bg-slate-100 text-slate-800"
        };
    }
}
