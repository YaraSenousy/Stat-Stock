@model ShipmentFormViewModel
@{
    ViewData["Title"] = "Outgoing Shipment";
}

<!-- Success/Error Messages -->
@if (TempData["Success"] != null)
{
    <div class="mb-6 bg-emerald-50 border border-emerald-200 rounded-xl p-4 flex items-center">
        <svg class="w-6 h-6 text-emerald-600 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        <p class="text-emerald-800 font-medium">@TempData["Success"]</p>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="mb-6 bg-red-50 border border-red-200 rounded-xl p-4 flex items-center">
        <svg class="w-6 h-6 text-red-600 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
        </svg>
        <p class="text-red-800 font-medium">@TempData["Error"]</p>
    </div>
}

<!-- Page Header -->
<div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 mb-2 flex items-center">
        <span class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center mr-3">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
            </svg>
        </span>
        Outgoing Shipment
    </h1>
    <p class="text-slate-600 ml-13">Log shipped inventory to decrease stock levels</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Search & Selection (Left) -->
    <div class="lg:col-span-2 space-y-6">
        <!-- Product Search -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
            <h2 class="text-lg font-semibold text-slate-900 mb-4">1. Select Product</h2>
            
            <form method="get" action="/Terminal/Terminal/OutgoingShipment">
                <div class="flex gap-3 mb-4">
                    <input type="text" 
                           id="searchInput"
                           name="search" 
                           value="@Model.SearchQuery"
                           placeholder="Search by SKU or name..."
                           autofocus
                           class="input-terminal flex-1 px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
                    <button type="submit" 
                            class="btn-terminal px-6 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-semibold rounded-xl shadow-lg transition-all">
                        Search
                    </button>
                </div>
            </form>

            <!-- Search Results -->
            @if (Model.SearchResults.Any())
            {
                <div class="border border-slate-200 rounded-xl divide-y divide-slate-200 max-h-80 overflow-y-auto">
                    @foreach (var product in Model.SearchResults)
                    {
                        <a href="/Terminal/Terminal/OutgoingShipment?productId=@product.Id" 
                           class="flex items-center justify-between p-4 hover:bg-blue-50 transition-colors @(Model.SelectedProductId == product.Id ? "bg-blue-50 border-l-4 border-blue-600" : "")">
                            <div class="flex-1">
                                <div class="flex items-center gap-3">
                                    <span class="font-mono text-sm text-slate-600">@product.SKU</span>
                                    <span class="font-semibold text-slate-900">@product.Name</span>
                                </div>
                                <div class="flex items-center gap-3 mt-1">
                                    <span class="text-sm px-2 py-0.5 bg-slate-100 text-slate-700 rounded">@product.Category</span>
                                    <span class="text-sm text-slate-600">Stock: @product.StockQuantity</span>
                                    @if (product.StockQuantity <= 0)
                                    {
                                        <span class="text-xs px-2 py-0.5 bg-red-100 text-red-700 rounded font-semibold">OUT OF STOCK</span>
                                    }
                                    else if (product.StockQuantity <= product.ReorderLevel)
                                    {
                                        <span class="text-xs px-2 py-0.5 bg-amber-100 text-amber-700 rounded font-semibold">LOW</span>
                                    }
                                </div>
                            </div>
                            @if (Model.SelectedProductId == product.Id)
                            {
                                <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                </svg>
                            }
                        </a>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <div class="text-center py-8 text-slate-500">
                    <svg class="w-12 h-12 mx-auto mb-2 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    <p>No products found</p>
                </div>
            }
        </div>
    </div>

    <!-- Shipment Form (Right) -->
    <div class="lg:col-span-1">
        @if (Model.SelectedProduct != null)
        {
            <!-- Selected Product Card -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-6">
                <div class="flex items-center gap-3 mb-4 pb-4 border-b border-slate-200">
                    <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center">
                        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                        </svg>
                    </div>
                    <div class="flex-1">
                        <p class="text-sm text-slate-600 font-mono">@Model.SelectedProduct.SKU</p>
                        <p class="font-semibold text-slate-900">@Model.SelectedProduct.Name</p>
                    </div>
                </div>
                
                <div class="space-y-3 text-sm">
                    <div class="flex justify-between">
                        <span class="text-slate-600">Category:</span>
                        <span class="font-medium text-slate-900">@Model.SelectedProduct.Category</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-600">Available Stock:</span>
                        @if (Model.SelectedProduct.StockQuantity <= 0)
                        {
                            <span class="font-semibold text-red-600">@Model.SelectedProduct.StockQuantity units (OUT OF STOCK)</span>
                        }
                        else if (Model.SelectedProduct.StockQuantity <= Model.SelectedProduct.ReorderLevel)
                        {
                            <span class="font-semibold text-amber-600">@Model.SelectedProduct.StockQuantity units (LOW)</span>
                        }
                        else
                        {
                            <span class="font-semibold text-emerald-600">@Model.SelectedProduct.StockQuantity units</span>
                        }
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-600">Reorder Level:</span>
                        <span class="font-medium text-slate-900">@Model.SelectedProduct.ReorderLevel</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-600">Unit Price:</span>
                        <span class="font-medium text-slate-900">$@Model.SelectedProduct.Price.ToString("N2")</span>
                    </div>
                </div>

                @if (Model.SelectedProduct.StockQuantity <= 0)
                {
                    <div class="mt-4 p-3 bg-red-50 border border-red-200 rounded-lg">
                        <div class="flex items-center">
                            <svg class="w-5 h-5 text-red-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                            </svg>
                            <p class="text-sm text-red-800 font-semibold">No stock available!</p>
                        </div>
                    </div>
                }
            </div>

            <!-- Shipment Entry Form -->
            <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl shadow-sm border-2 border-blue-200 p-6">
                <h2 class="text-lg font-semibold text-slate-900 mb-4">2. Enter Quantity</h2>
                
                <form method="post" action="/Terminal/Terminal/OutgoingShipment" id="shipmentForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.SelectedProduct.Id" />
                    
                    <div class="space-y-4">
                        <div>
                            <label for="quantity" class="block text-sm font-semibold text-slate-700 mb-2">
                                Quantity Shipped <span class="text-red-500">*</span>
                            </label>
                            <input type="number" 
                                   id="quantity"
                                   name="quantity" 
                                   min="1"
                                   max="@Model.SelectedProduct.StockQuantity"
                                   value="@Model.Quantity"
                                   required
                                   class="input-terminal w-full px-4 py-3 border-2 border-blue-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-center text-2xl font-bold" 
                                   accesskey="q" />
                            <p class="mt-2 text-sm text-slate-600">
                                Max: @Model.SelectedProduct.StockQuantity units &bull; 
                                <kbd class="kbd-hint">Alt+Q</kbd> to focus
                            </p>
                        </div>

                        <div>
                            <label for="notes" class="block text-sm font-semibold text-slate-700 mb-2">
                                Notes (optional)
                            </label>
                            <textarea id="notes"
                                      name="notes" 
                                      rows="3"
                                      placeholder="Add any notes about this shipment..."
                                      class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 resize-none">@Model.Notes</textarea>
                        </div>

                        @if (Model.SelectedProduct.StockQuantity > 0)
                        {
                            <button type="submit" 
                                    class="btn-terminal w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 flex items-center justify-center">
                                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                </svg>
                                Record Outgoing Shipment
                            </button>

                            <p class="text-center text-sm text-slate-600">
                                <kbd class="kbd-hint">Alt+Enter</kbd> to submit
                            </p>
                        }
                        else
                        {
                            <button type="button" 
                                    disabled
                                    class="btn-terminal w-full bg-slate-300 text-slate-500 font-bold rounded-xl cursor-not-allowed flex items-center justify-center">
                                <svg class="w-6 h-6 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M13.477 14.89A6 6 0 015.11 6.524l8.367 8.368zm1.414-1.414L6.524 5.11a6 6 0 018.367 8.367zM18 10a8 8 0 11-16 0 8 8 0 0116 0z" clip-rule="evenodd"></path>
                                </svg>
                                Cannot Ship - No Stock
                            </button>
                        }
                    </div>
                </form>
            </div>
        }
        else
        {
            <!-- Placeholder -->
            <div class="bg-slate-50 rounded-2xl border-2 border-dashed border-slate-300 p-8 text-center">
                <div class="w-16 h-16 bg-slate-200 rounded-full mx-auto mb-4 flex items-center justify-center">
                    <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                    </svg>
                </div>
                <p class="text-slate-600 font-medium">No product selected</p>
                <p class="text-sm text-slate-500 mt-2">Search and select a product to continue</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Alt+Q to focus quantity field
        document.addEventListener('keydown', function(e) {
            if (e.altKey && e.key === 'q') {
                e.preventDefault();
                const quantityField = document.getElementById('quantity');
                if (quantityField) {
                    quantityField.focus();
                    quantityField.select();
                }
            }
        });

        // Auto-focus search or quantity based on context
        document.addEventListener('DOMContentLoaded', function() {
            const quantityField = document.getElementById('quantity');
            const searchField = document.getElementById('searchInput');
            
            if (quantityField) {
                quantityField.focus();
                quantityField.select();
            } else if (searchField) {
                searchField.focus();
            }
        });
    </script>
}
